<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.repdev</groupId>
	<artifactId>repdev</artifactId>
	<version>2.0.0</version>
	<packaging>jar</packaging>

	<name>RepDev</name>
	<description>RepGen IDE for Symitar</description>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<repdev.swt.version>3.133.0</repdev.swt.version>
		<repdev.swt.svg.version>3.131.0</repdev.swt.svg.version>
		<repdev.jsvg.version>2.0.0</repdev.jsvg.version>
		<repdev.junit.version>5.11.4</repdev.junit.version>
		<repdev.app.dir>${project.build.directory}/app</repdev.app.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.swt</artifactId>
			<version>${repdev.swt.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.swt.svg</artifactId>
			<version>${repdev.swt.svg.version}</version>
		</dependency>
		<dependency>
			<groupId>com.github.weisj</groupId>
			<artifactId>jsvg</artifactId>
			<version>${repdev.jsvg.version}</version>
		</dependency>
		<dependency>
			<groupId>org.repdev</groupId>
			<artifactId>swtcompare</artifactId>
			<version>${project.version}</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/swtcompare.jar</systemPath>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${repdev.junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>repdev</finalName>
		<sourceDirectory>${project.basedir}</sourceDirectory>
		<testSourceDirectory>${project.basedir}/test</testSourceDirectory>
		<resources>
			<resource>
				<directory>${project.basedir}</directory>
				<excludes>
					<exclude>**/*.java</exclude>
					<exclude>**/*.class</exclude>
					<exclude>.classpath</exclude>
					<exclude>.project</exclude>
					<exclude>.gitignore</exclude>
					<exclude>.hgignore</exclude>
					<exclude>.settings/**</exclude>
					<exclude>.git/**</exclude>
					<exclude>.mvn/repository/**</exclude>
					<exclude>.codex/**</exclude>
					<exclude>.omc/**</exclude>
					<exclude>.claude/**</exclude>
					<exclude>bin/**</exclude>
					<exclude>dist/**</exclude>
					<exclude>docs/**</exclude>
					<exclude>out/**</exclude>
					<exclude>target/**</exclude>
					<exclude>test/**</exclude>
					<exclude>tmp/**</exclude>
					<exclude>backup/**</exclude>
					<exclude>testdata/**</exclude>
					<exclude>pom.xml</exclude>
					<exclude>repdev.exe</exclude>
					<exclude>swtcompare.jar</exclude>
					<exclude>RepDev_fork.zip</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.14.0</version>
				<configuration>
					<encoding>${project.build.sourceEncoding}</encoding>
					<excludes>
						<exclude>bin/**</exclude>
						<exclude>dist/**</exclude>
						<exclude>out/**</exclude>
						<exclude>test/**</exclude>
						<exclude>tmp/**</exclude>
						<exclude>backup/**</exclude>
						<exclude>testdata/**</exclude>
						<exclude>.mvn/**</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.repdev.RepDevMain</mainClass>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-runtime-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${repdev.app.dir}/lib</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-app-layout</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${repdev.app.dir}</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}</directory>
									<filtering>false</filtering>
									<excludes>
										<exclude>**/*.java</exclude>
										<exclude>**/*.class</exclude>
										<exclude>.classpath</exclude>
										<exclude>.project</exclude>
										<exclude>.gitignore</exclude>
										<exclude>.hgignore</exclude>
										<exclude>.settings/**</exclude>
										<exclude>.git/**</exclude>
										<exclude>.mvn/**</exclude>
										<exclude>.codex/**</exclude>
										<exclude>.omc/**</exclude>
										<exclude>.claude/**</exclude>
										<exclude>bin/**</exclude>
										<exclude>dist/**</exclude>
										<exclude>docs/**</exclude>
										<exclude>out/**</exclude>
										<exclude>tmp/**</exclude>
										<exclude>backup/**</exclude>
										<exclude>testdata/**</exclude>
										<exclude>test/**</exclude>
										<exclude>target/**</exclude>
										<exclude>pom.xml</exclude>
										<exclude>repdev.exe</exclude>
										<exclude>swtcompare.jar</exclude>
										<exclude>RepDev_fork.zip</exclude>
										<exclude>com/repdev/launcher/launcher.jar</exclude>
									</excludes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-main-jar</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${repdev.app.dir}</outputDirectory>
							<resources>
								<resource>
									<directory>${project.build.directory}</directory>
									<includes>
										<include>${project.build.finalName}.jar</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-local-runtime-jars</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${repdev.app.dir}/lib</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}</directory>
									<includes>
										<include>swtcompare.jar</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
