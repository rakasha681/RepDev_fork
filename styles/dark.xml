<RepDevStyle>
  <header>
    <name>Dark</name>
    <version>2.0</version>
    <author>RepDev</author>
    <description><![CDATA[Modern dark theme inspired by VS Code Dark+. Soft dark grays rather than pure black for reduced eye strain. Replaces the classic dark; the original neon-glow dark is still available as "legacy-dark".]]>
    </description>
  </header>

  <style>
    <editor bgColor="#202124" fgColor="#D6D7DA" line="#2A2C31" token="#33475F" font="Courier New" fontSize="12" gutterBg="#1B1C1F" selectionBg="#3A5270" selectionFg="#FFFFFF" findMatchBg="#59412F" />

    <surface   bgColor="#27282B" fgColor="#D6D7DA" sashColor="#42454D" borderColor="#42454D" />
    <button    bgColor="#303238" fgColor="#FFFFFF" />
    <selection bgColor="#3A5270" fgColor="#FFFFFF" />
    <tabStyle  selBg="#202124"   selFg="#FFFFFF" inactiveBg="#303238" inactiveFg="#A0A5AD" borderColor="#42454D" selThickness="3" />

    <linenumber fgColor="#858585" />
    <comments   fgColor="#6A9955" />
    <variables  fgColor="#9CDCFE" style="bold,italic" />
    <functions  fgColor="#DCDCAA" style="bold" />
    <keywords   fgColor="#569CD6" />
    <task       fgColor="#D7BA7D" style="bold" />

    <typeChar fgColor="#CE9178" />
    <typeDate fgColor="#CE9178" style="bold" />

    <struct1    fgColor="#4EC9B0" />
    <struct1Inv fgColor="#4EC9B0" bgColor="#5A1D1D" />
    <struct2    fgColor="#9CDCFE" />
    <struct2Inv fgColor="#9CDCFE" bgColor="#5A1D1D" />

    <rainbow c1="#FFD700" c2="#DA70D6" c3="#00BFFF" c4="#32CD32" c5="#FF6347" c6="#FFA500" />
  </style>
</RepDevStyle>
