    <tabStyle inactiveBg="#0F1F3D" inactiveFg="#8892B0" borderColor="#1E3A5F" />
    <functions fgColor="#64FFDA" />
    <keywords fgColor="#F43F5E" />
    <rainbow c1="#FACC15" c2="#F472B6" c3="#64FFDA" c4="#A7F3D0" c5="#F87171" c6="#FDBA74" />
  </style>
</RepDevStyle>
