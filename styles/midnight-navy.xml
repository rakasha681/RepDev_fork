<RepDevStyle extends="dark">
  <header>
    <name>Midnight Navy</name>
    <version>1.0</version>
    <author>Gemini</author>
    <description><![CDATA[Deep navy blue variant. Low fatigue for late-night coding.]]></description>
  </header>
  <palette>
    <color id="navy-bg" value="#0A192F" />
    <color id="navy-gutter" value="#051020" />
