<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>..\..\..\target\app\repdev.jar</jar>
  <outfile>..\..\..\target\windows\repdev.exe</outfile>
  <errTitle></errTitle>
  <cmdLine></cmdLine>
  <chdir>..\..\..\target\app</chdir>
  <priority>normal</priority>
  <downloadUrl>http://java.com/download</downloadUrl>
  <supportUrl></supportUrl>
  <customProcName>true</customProcName>
  <stayAlive>false</stayAlive>
  <manifest></manifest>
  <icon>..\..\..\repdev-icons\monkeyIcon32.ico</icon>
  <jre>
    <path></path>
    <minVersion>21.0.0</minVersion>
    <maxVersion></maxVersion>
    <jdkPreference>preferJdk</jdkPreference>
    <initialHeapSize>128</initialHeapSize>
    <maxHeapSize>384</maxHeapSize>
    <opt>-Djava.library.path=lib</opt>
    <opt>-Dfile.encoding=UTF-8</opt>
  </jre>
  <versionInfo>
    <fileVersion>2.0.0.0</fileVersion>
    <txtFileVersion>2.0.0</txtFileVersion>
    <fileDescription>RepDev</fileDescription>
    <copyright>(c) 2008-2026 RepDev LLC</copyright>
    <productVersion>2.0.0.0</productVersion>
    <txtProductVersion>2.0.0</txtProductVersion>
    <productName>RepDev</productName>
    <companyName>RepDev LLC</companyName>
    <internalName>RepDev</internalName>
    <originalFilename>repdev.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
